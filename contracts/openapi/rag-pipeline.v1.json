  "components": {
    "schemas": {
      "AuditEventResponse": {
        "required": [
          "id",
          "occurredAt",
          "actorUserId",
          "actorType",
          "tenantId",
          "action",
          "targetResource",
          "targetId",
          "outcome",
          "correlationId",
          "detailsJson"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "actorUserId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "actorType": {
            "type": "string"
          },
          "tenantId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "action": {
            "type": "string"
          },
          "targetResource": {
            "type": "string"
          },
          "targetId": {
            "type": [
              "null",
              "string"
            ]
          },
          "outcome": {
            "type": "string"
          },
          "correlationId": {
            "type": [
              "null",
              "string"
            ]
          },
          "detailsJson": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "DeploymentAdminStatusResponse": {
        "required": [
          "status",
          "timestamp"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DeploymentKeyRootResponse": {
        "required": [
          "status",
          "keyRingVersion"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "keyRingVersion": {
            "type": "string"
          }
        }
      },
      "LiveHealthResponse": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "PagedAuditEventsResponse": {
        "required": [
          "items",
          "page",
          "pageSize",
          "totalCount"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditEventResponse"
            }
          },
          "page": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "pageSize": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "totalCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "ProblemDetails": {
        "required": [
          "traceId"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "traceId": {
            "type": "string"
          }
        }
      },
      "ReadinessReport": {
        "required": [
          "status",
          "dependencies"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "dependencies": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "TenantProfileDto": {
        "required": [
          "tenantId",
          "displayName",
          "settingsJson",
          "createdAt",
          "updatedAt"
        ],
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "settingsJson": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TenantSettingsResponse": {
        "required": [
          "tenantId",
          "displayName",
          "settingsJson"
        ],
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "settingsJson": {
            "type": "string"
          }
        }
      },
      "UpdateTenantSettingsRequest": {
        "required": [
          "displayName",
          "settingsJson"
        ],
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string"
          },
          "settingsJson": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Tenants"
    },
    {
      "name": "Health"
    },
    {
      "name": "DeploymentAdmin"
    }
  ]
}
